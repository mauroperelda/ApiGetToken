# ────────────────────────────────────────────────────────────
# .gitignore único del repo ApiGetToken
# Las reglas aplican recursivamente a todo el árbol.
# ────────────────────────────────────────────────────────────

# --- Build results ---
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild[Ll]og.*
*.[Pp]ublish.xml
*.pidb

# --- .NET / ASP.NET Core ---
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json
*.staticwebassets.endpoints.json
project.assets.json
project.nuget.cache
project.fragment.nuget.cache
app.config
*.manifest
*.local

# --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# --- Test results ---
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# --- Visual Studio ---
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs

# --- ReSharper / Rider ---
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.sln.ide

# --- IDEs / Editores ---
.vscode/

# --- OS junk ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Logs ---
*.log
logs/
*.trx

# --- Misc ---
*.tmp
*.bak
*.swp
*.swo

# --- Secretos locales (no se commitean NUNCA) ---
# Mantenemos esta convención propia (no la default de ASP.NET) porque
# guardamos los secretos reales del entorno Development del desarrollador.
appsettings.Development.json
secrets.json
